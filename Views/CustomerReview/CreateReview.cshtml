@model HotelManagementSystem.Dto.RequestModel.CreateReview

@{
    if (User.IsInRole("Admin"))
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Rooms";
    }
    else
    {
        Layout = "_Layout";
    }
}


<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12 col-12">
            <div class="bg-secondary rounded h-100 p-4">
                <h6 class="mb-4"> Review</h6>
                <form asp-controller="CustomerReview" asp-action="CreateReview">

                    <div class="row">
                        <div class="col mb-6">
                            <label class="form-label">Comment</label>
                            <input type="text" class="form-control" name="comment" aria-describedby="comment">
                        </div>
                        <div class="col mb-6">
                            <label asp-for="Rating"></label>
                            <select asp-for="Rating" class="form-select" asp-items="Html.GetEnumSelectList<HotelManagementSystem.Model.Entity.Enum.Review>()">
                                <option value=""></option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Add Comment</button>
                    <a href="@Url.Action("Rooms","Room")" class="btn btn-dark ms-2">Show All</a>
                    </div>
                </form>
            </div>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3 float-end">Home Page</a>
        </div>
    </div>
</div>
