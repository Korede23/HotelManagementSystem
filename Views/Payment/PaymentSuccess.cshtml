@{
    if (User.IsInRole("Admin"))
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Rooms";
    }
    else
    {
        Layout = "_Layout";
    }
}

<h2>Payment Initiated Successfully</h2>

<p>Your payment has been initiated successfully. Your reference number is <strong>@ViewBag.Reference</strong>.</p>
<p>Please proceed to complete your payment.</p>
