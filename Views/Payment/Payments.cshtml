@model HotelManagementSystem.Model.Entity.PaginatedList<HotelManagementSystem.Dto.PaymentDto>

@{
    if (User.IsInRole("Admin"))
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Payments";
    }
    else
    {
        Layout = "_Layout";
    }
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-secondary text-center rounded p-4">
        @if (Model != null && Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table text-start align-middle table-bordered table-hover mb-0">
                    <thead>
                        <tr class="text-white">
                            <th scope="col"><input class="form-check-input" type="checkbox"></th>
                            <th scope="col">Amount</th>
                            <th scope="col">Transaction Reference</th>
                            <th scope="col">Date Created</th>
                            <th scope="col">Date Requested</th>
                            <th scope="col">Email</th>
                            <th scope="col">Payment Status</th>
                            <th scope="col">Created By</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><input class="form-check-input" type="checkbox"></td>
                                <td>@item.Amount</td>
                                <td>@item.TransactionReference</td>
                                <td>@item.CreatedOn</td>
                                <td>@item.DateRequested</td>
                                <td>@item.Email</td>
                                <td>@item.Status</td>
                                <td>@item.CreatedBy</td>
                                <td>
                                    <a asp-controller="Payment" asp-action="GetPaymentById" asp-route-id="@item.Id">View Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" href="@Url.Action("Payments", new { pageNumber = Model.PageNumber - 1, pageSize = Model.PageSize })">
                            &laquo; Previous
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Payments", new { pageNumber = i, pageSize = Model.PageSize })">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" href="@Url.Action("Payments", new { pageNumber = Model.PageNumber + 1, pageSize = Model.PageSize })">
                            Next &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        }
        else
        {
            <h3>No payments have been made</h3>
        }
    </div>
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3 float-end">Home Page</a>
</div>
