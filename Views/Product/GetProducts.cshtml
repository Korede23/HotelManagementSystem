@model HotelManagementSystem.Model.Entity.PaginatedList<HotelManagementSystem.Dto.ProductDto>

@{
    if (User.IsInRole("Admin"))
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Products";
    }
    else
    {
        Layout = "_Layout";
    }
}

<h2 class="text-center">Products</h2>

<form class="d-flex justify-content-center mb-4" action="@Url.Action("GetProducts", "Product")" method="get">
    <input class="form-control bg-dark border-0" name="searchTerm" type="search" placeholder="Search by product Name " value="@Context.Request.Query["searchTerm"]">
    <button class="btn btn-primary ms-2" type="submit">Search</button>
</form>

<div class="row justify-content-center">
    @if (Model.Items.Any())
    {
        foreach (var product in Model.Items)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title">@product.Name (@product.Price)</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Name:</strong> @product.Name</p>
                        <p><strong>Price:</strong> @product.Price</p>
                    </div>
                    <div class="card-footer text-center">
                        @if (product.ImageUrls.Any())
                        {
                            <div class="d-flex justify-content-center">
                                @foreach (var imageUrl in product.ImageUrls.Take(3))
                                {
                                    <div class="thumbnail mb-2">
                                        <img src="~/@imageUrl" class="img-fluid" style="max-width: 80px; max-height: 80px; object-fit: cover; cursor: pointer;" onclick="displayMainImage('~/@imageUrl')" alt="Thumbnail">
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p>No images available</p>
                        }
                        <div class="mt-3">
                            <a asp-controller="Product" asp-route-id="@product.Id" asp-action="GetAllProductById" class="btn btn-info">View Details</a>
                        </div>
                    </div>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3 float-end">Home Page</a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-warning text-center">
                No rooms found.
            </div>
        </div>
    }
</div>

<div class="d-flex justify-content-between mt-4">
    <div>
        <span>Page @(Model.PageNumber) of @(Model.TotalPages)</span>
    </div>
    <div>
        @if (Model.HasPreviousPage)
        {
            <a class="btn btn-primary" asp-action="GetProducts" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Context.Request.Query["searchTerm"]">Previous</a>
        }
        @if (Model.HasNextPage)
        {
            <a class="btn btn-primary" asp-action="GetProducts" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Context.Request.Query["searchTerm"]">Next</a>
        }
    </div>
</div>
