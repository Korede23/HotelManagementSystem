@model HotelManagementSystem.Dto.ProductDto

@{
    if (User.IsInRole("Admin"))
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Rooms";
    }
    else
    {
        Layout = "_Layout";
    }
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-secondary text-center rounded p-4">
        <h2>Product Details</h2>

        <div class="row mt-4">
            <div class="col-md-2 d-flex flex-md-column justify-content-center align-items-center">
                @if (Model.ImageUrls != null && Model.ImageUrls.Count > 0)
                {
                    @foreach (var imageUrl in Model.ImageUrls)
                    {
                        <div class="thumbnail mb-2">
                            <img src="~/@imageUrl" class="img-fluid" style="max-width: 80px; max-height: 80px; object-fit: cover; cursor: pointer;" onclick="displayMainImage('~/@imageUrl')" alt="Thumbnail">
                        </div>
                    }
                }
                else
                {
                    <div class="thumbnail mb-2">
                        <img src="~/ProductImages/default-image.jpg" class="img-fluid" style="max-width: 80px; max-height: 80px; object-fit: cover;" alt="Thumbnail">
                    </div>
                }
            </div>
            <div class="col-md-6">
                <img id="mainProductImage" src="~/@(Model.ImageUrls?.FirstOrDefault() ?? "ProductImages/default-image.jpg")" class="img-fluid" style="max-width: 100%; max-height: 500px; object-fit: contain;" alt="Main Product Image">
            </div>
            <div class="col-md-4">
                <table class="table text-start align-middle table-bordered table-hover">
                    <tbody>
                        <tr>
                            <th scope="row">Name</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th scope="row">Price</th>
                            <td>₦ @Model.Price</td>
                        </tr>
                    </tbody>
                </table>
                <a href="@Url.Action("CreateOrder", "Order", new { productId = Model.Id })" class="btn btn-primary mt-3">Place Order</a>
                <a href="@Url.Action("Products", "Product")" class="btn btn-primary mt-3">Back to List</a>
            </div>
        </div>
    </div>
</div>

<script>
    function displayMainImage(imageUrl) {
        document.getElementById("mainProductImage").src = imageUrl;
    }
</script>
