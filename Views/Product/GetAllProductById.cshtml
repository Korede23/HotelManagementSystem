@model HotelManagementSystem.Dto.ProductDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "products Details";
}


<div class="container-fluid pt-4 px-4">
    <div class="bg-secondary text-center rounded p-4">
        <h2>Product Details</h2>
        <div id="slider" class="carousel slide mt-4" data-bs-ride="carousel">
            <div class="carousel-inner">
                @if (Model.Images != null)
                {
                    for (var i = 0; i < Model.Images.Count(); i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="~/RoomImages/@Model.Images[i].ImagePath" class="d-block w-100" style="max-height:300px;  object-fit: cover;" alt="Room image @(i + 1)">
                        </div>
                    }
                }
                else
                {
                    <div class="carousel-item active">
                        <img src="/images/default-room.jpg" class="d-block w-100" alt="Default room image">
                    </div>
                }
            </div>
            <a class="carousel-control-prev" href="#slider" role="button" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </a>
            <a class="carousel-control-next" href="#slider" role="button" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </a>
        </div>
        <div class="table-responsive">
            @if (Model != null)
            {
                <table class="table text-start align-middle table-bordered table-hover mb-0">
                    <tbody>
                        <tr>
                            <th scope="row">Name</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th scope="row">Price</th>
                            <td>@Model.Price</td>
                        </tr>
                    </tbody>
                </table>
            }
            else
            {
                <p>Product details are not available.</p>
            }
            <a href="@Url.Action("Products", "Product")" class="btn btn-primary mt-3">Back to List</a>
        </div>
    </div>
</div>
